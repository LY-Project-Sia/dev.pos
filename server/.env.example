DATABASE_URL=postgres://courtflow:change-this-password@localhost:5432/courtflow
PORT=4000
APP_ORIGIN=http://localhost:5173
SESSION_HOURS=12
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
NODE_ENV=development

# Optional: configure SMTP to send customer receipts
# Gmail: use your Gmail address and a Google App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM=youraddress@gmail.com
