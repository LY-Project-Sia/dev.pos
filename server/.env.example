DATABASE_URL=postgres://courtflow:change-this-password@localhost:5432/courtflow
PORT=4000
APP_ORIGIN=http://localhost:5173
SESSION_HOURS=12
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
NODE_ENV=development

# Optional: configure SMTP to send customer receipts
# Brevo transactional email: https://app.brevo.com/settings/keys/smtp\n# Use your Brevo SMTP login and SMTP key, NOT your Brevo account password or API key.\n# Keep actual credentials only in your private server/.env, never in GitHub.\nSMTP_HOST=smtp-relay.brevo.com\nSMTP_PORT=587\nSMTP_USER=YOUR_BREVO_SMTP_LOGIN\nSMTP_PASS=YOUR_BREVO_SMTP_KEY\nSMTP_FROM=YOUR_VERIFIED_SENDER_EMAIL
